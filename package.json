{
  "name": "my-qwik-basic-starter",
  "description": "App with Routing built-in (recommended)",
  "engines": {
    "node": ">=20.0.0"
  },
  "trustedDependencies": [
    "sharp"
  ],
  "private": true,
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/express/vite.config.ts",
    "build.types": "echo hello",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk=0.0.0.0:9230 ./node_modules/vite/bin/vite.js --mode ssr --force --port 3000",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "echo hello",
    "preview": "qwik build preview && vite preview --open",
    "fetch-secrets": "bun fetchsecrets.ts",
    "serve": "node server/entry.express",
    "start": "vite --port 3000 --mode ssr",
    "test.unit": "vitest components",
    "test.unit.ui": "vitest --ui components",
    "qwik": "qwik",
    "postinstall": "node scripts-patch-web3modal.js"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.5.1",
    "@builder.io/qwik-city": "^1.5.1",
    "@builder.io/qwik-react": "0.5.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.13.0",
    "@mui/x-data-grid": "^6.4.0",
    "@types/compression": "^1.7.2",
    "@types/eslint": "8.37.0",
    "@types/express": "4.17.17",
    "@types/node": "^18.15.9",
    "@types/prettier": "^2.7.2",
    "@types/prismjs": "^1.26.3",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.13",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "5.59.0",
    "@typescript-eslint/parser": "5.59.0",
    "@vitest/ui": "^0.29.7",
    "compression": "^1.7.4",
    "eslint": "8.38.0",
    "eslint-plugin-qwik": "0.103.0",
    "express": "4.18.2",
    "prettier": "^2.8.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "typescript": "5.0.4",
    "vite": "^5.0.0",
    "vite-tsconfig-paths": "4.3.1",
    "vitest": "^0.29.7"
  },
  "dependencies": {
    "@azure/identity": "^3.4.2",
    "@azure/keyvault-secrets": "^4.7.0",
    "@clerk/clerk-js": "^6.32.1",
    "@clerk/themes": "^1.7.5",
    "@clerk/ui": "^1.33.1",
    "@sentry/browser": "^8.2.1",
    "@sentry/vite-plugin": "^2.16.1",
    "@shoelace-style/shoelace": "^2.7.0",
    "@types/mime": "^3.0.1",
    "@wagmi/core": "^1.3.9",
    "@web3modal/ethereum": "^2.7.1",
    "@web3modal/html": "^2.7.1",
    "abitype": "^1.0.2",
    "axios": "^1.3.6",
    "dotenv": "^16.4.3",
    "ethers": "^5.7.2",
    "highlight.js": "^11.8.0",
    "highlightjs-solidity": "^2.0.6",
    "mime": "^3.0.0",
    "react-syntax-highlighter": "^15.5.0",
    "sass": "^1.62.0",
    "viem": "^1.5.4"
  },
  "version": "1.0.1"
}