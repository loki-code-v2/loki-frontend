# ===== Loki frontend environment =====
# Copy to .env. Vite inlines VITE_* at BUILD time - changing them requires a rebuild.
# NOTE: if deploying with Docker, each VITE_* var must also be declared as an ARG
# in the Dockerfile (Railway only passes declared ARGs into Docker builds).

VITE_LOKI_API_URL=http://localhost:3001/
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_ENVIRONMENT=
VITE_GITHUB_APP_URL=https://github.com/apps/your-github-app
VITE_GITHUB_APP_INSTALLATION_CALLBACK_URL=http://localhost:3000/github-callback
